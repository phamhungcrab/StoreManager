<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane fx:controller="com.example.storemanagement.controller.MainController"
    xmlns:fx="http://javafx.com/fxml"
    prefWidth="1000.0" prefHeight="640.0">

    <!-- Top menu -->
    <top>
        <MenuBar BorderPane.alignment="CENTER">
            <menus>
                <Menu text="Tệp">
                    <items>
                        <MenuItem text="Thoát" onAction="#exitApp" />
                    </items>
                </Menu>
                <Menu text="Xem">
                    <items>
                        <MenuItem text="Khách hàng" onAction="#openCustomers" />
                        <MenuItem text="Kho hàng" onAction="#openInventory" />
                        <MenuItem text="Tài chính" onAction="#openFinance" />
                        <MenuItem fx:id="toggleMusicItem" text="🔊 Tắt nhạc nền"
                            onAction="#onToggleMusic" />
                    </items>
                </Menu>
                <Menu text="Trợ giúp">
                    <items>
                        <MenuItem text="Giới thiệu" onAction="#openAbout" />
                    </items>
                </Menu>
            </menus>
        </MenuBar>
    </top>

    <!-- Left navigation -->
    <left>
        <VBox spacing="8.0" BorderPane.alignment="CENTER_LEFT" styleClass="md-card-elevated">
            <padding>
                <Insets top="8" right="8" bottom="8" left="8" />
            </padding>
            <children>
                <Label text="Điều hướng" style="-fx-font-weight: bold; -fx-padding: 8 0 0 8;" />
                <Button fx:id="btnCustomers" text="Khách hàng" onAction="#openCustomers"
                    maxWidth="Infinity" styleClass="md-button-primary" />
                <Button fx:id="btnInventory" text="Kho hàng" onAction="#openInventory"
                    maxWidth="Infinity" styleClass="md-button-primary" />
                <Button fx:id="btnFinance" text="Tài chính" onAction="#openFinance"
                    maxWidth="Infinity" styleClass="md-button-primary" />
                <Button fx:id="btnOrders" text="Đơn hàng" onAction="#openOrders"
                    maxWidth="Infinity" styleClass="md-button-primary" />
                <Button fx:id="btnOrderLogs" text="Lịch sử đơn hàng" onAction="#openOrderLogs"
                    maxWidth="Infinity" styleClass="md-button-primary" />
                <Button fx:id="btnLogistics" text="Vận chuyển" onAction="#openLogistics"
                    maxWidth="Infinity" styleClass="md-button-primary" />
                <Button fx:id="btnAccountant" text="Kế toán" onAction="#openAccountant"
                    maxWidth="Infinity" styleClass="md-button-primary" />
                <Button fx:id="btnSellerBudget" text="Quỹ bán hàng" onAction="#openSellerBudget"
                    maxWidth="Infinity" styleClass="md-button-primary" />

                <!-- New Report Button -->
                <MenuButton fx:id="btnReports" text="Báo cáo" maxWidth="Infinity"
                    styleClass="md-button-primary">
                    <items>
                        <MenuItem text="Báo cáo thu chi" onAction="#onReportIncomeExpense" />
                        <MenuItem text="Gửi báo cáo cho kế toán"
                            onAction="#onSendReportToAccountant" />
                    </items>
                </MenuButton>

                <Button fx:id="btnUsers" text="Người dùng" onAction="#openUsers"
                    maxWidth="Infinity" styleClass="md-button-primary" />
            </children>
        </VBox>
    </left>

    <!-- Center content area -->
    <center>
        <StackPane fx:id="contentArea" BorderPane.alignment="CENTER">
            <children>
                <Label text="Đang tải..." />
            </children>
        </StackPane>
    </center>

    <!-- Bottom status bar -->
    <bottom>
        <HBox spacing="12.0" BorderPane.alignment="CENTER"
            style="-fx-padding: 8; -fx-background-color: #f6f6f6; -fx-border-color: #e2e2e2; -fx-border-width: 1 0 0 0;">
            <children>
                <Label fx:id="statusLabel" text="Trạng thái: Sẵn sàng" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="welcomeLabel" text="Xin chào!" style="-fx-font-size: 18px;" />
                <Button fx:id="logoutBtn" text="Đăng xuất" onAction="#handleLogout" />
            </children>
        </HBox>
    </bottom>
</BorderPane>