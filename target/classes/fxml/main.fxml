<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane fx:controller="com.example.storemanagement.controller.MainController"
    xmlns:fx="http://javafx.com/fxml"
    prefWidth="1000.0" prefHeight="640.0">

    <!-- Top menu -->
    <top>
        <MenuBar BorderPane.alignment="CENTER">
            <menus>
                <Menu text="File">
                    <items>
                        <MenuItem text="Exit" onAction="#exitApp" />
                    </items>
                </Menu>
                <Menu text="View">
                    <items>
                        <MenuItem text="Customers" onAction="#openCustomers" />
                        <MenuItem text="Inventory" onAction="#openInventory" />
                        <MenuItem text="Finance" onAction="#openFinance" />
                        <MenuItem fx:id="toggleMusicItem" text="🔊 Tắt nhạc nền"
                            onAction="#onToggleMusic" />
                    </items>
                </Menu>
                <Menu text="Help">
                    <items>
                        <MenuItem text="About" onAction="#openAbout" />
                    </items>
                </Menu>
            </menus>
        </MenuBar>
    </top>

    <!-- Left navigation -->
    <left>
        <VBox spacing="8.0" BorderPane.alignment="CENTER_LEFT" styleClass="md-card-elevated">
            <padding>
                <Insets top="8" right="8" bottom="8" left="8" />
            </padding>
            <children>
                <Label text="Navigation" style="-fx-font-weight: bold; -fx-padding: 8 0 0 8;" />
                <Button fx:id="btnCustomers" text="Customers" onAction="#openCustomers"
                    maxWidth="Infinity" styleClass="md-button-primary" />
                <Button fx:id="btnInventory" text="Inventory" onAction="#openInventory"
                    maxWidth="Infinity" styleClass="md-button-primary" />
                <Button fx:id="btnFinance" text="Finance" onAction="#openFinance"
                    maxWidth="Infinity" styleClass="md-button-primary" />
                <Button fx:id="btnOrders" text="Orders" onAction="#openOrders"
                    maxWidth="Infinity" styleClass="md-button-primary" />
                <Button fx:id="btnOrderLogs" text="Order Logs" onAction="#openOrderLogs"
                    maxWidth="Infinity" styleClass="md-button-primary" />
                <Button fx:id="btnLogistics" text="Logistics" onAction="#openLogistics"
                    maxWidth="Infinity" styleClass="md-button-primary" />
                <Button fx:id="btnAccountant" text="Accountant" onAction="#openAccountant"
                    maxWidth="Infinity" styleClass="md-button-primary" />
                <Button fx:id="btnSellerBudget" text="Seller Budget" onAction="#openSellerBudget"
                    maxWidth="Infinity" styleClass="md-button-primary" />
                <Button fx:id="btnUsers" text="Users" onAction="#openUsers"
                    maxWidth="Infinity" styleClass="md-button-primary" />
            </children>
        </VBox>
    </left>

    <!-- Center content area -->
    <center>
        <StackPane fx:id="contentArea" BorderPane.alignment="CENTER">
            <children>
                <Label text="Loading..." />
            </children>
        </StackPane>
    </center>

    <!-- Bottom status bar -->
    <bottom>
        <HBox spacing="12.0" BorderPane.alignment="CENTER"
            style="-fx-padding: 8; -fx-background-color: #f6f6f6; -fx-border-color: #e2e2e2; -fx-border-width: 1 0 0 0;">
            <children>
                <Label fx:id="statusLabel" text="Status: ready" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="welcomeLabel" text="Xin chào!" style="-fx-font-size: 18px;" />
                <Button fx:id="logoutBtn" text="Đăng xuất" onAction="#handleLogout" />
            </children>
        </HBox>
    </bottom>
</BorderPane>